/**pages/profile/profile.wxss**/
.container {
  padding: 16px;
  padding-bottom: 100px;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 16px;
  color: #fff;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}

.user-avatar-large {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.3);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.user-name-large {
  font-size: 22px;
  font-weight: 600;
}

.user-role {
  font-size: 14px;
  opacity: 0.9;
}

.user-department {
  font-size: 13px;
  opacity: 0.8;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.stat-value {
  font-size: 20px;
  font-weight: 600;
}

.stat-label {
  font-size: 12px;
  opacity: 0.8;
}

/* 菜单区域 */
.menu-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.menu-group {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f5f5f5;
}

.menu-icon {
  width: 36px;
  height: 36px;
  background: #f0f7ff;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}

.menu-icon .iconfont {
  font-size: 20px;
  color: #1890ff;
}

.menu-text {
  flex: 1;
  font-size: 15px;
  color: #333;
}

.menu-version {
  font-size: 13px;
  color: #999;
  margin-right: 8px;
}

.icon-arrow-right {
  font-size: 14px;
  color: #ccc;
}

/* 退出登录 */
.logout-section {
  margin-top: 32px;
  padding: 0 16px;
}

.logout-btn {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background: #fff;
  color: #ff4d4f;
  font-size: 16px;
  border-radius: 8px;
  border: none;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.logout-btn:active {
  background: #fff2f0;
}
