/**pages/index/index.wxss**/
.container {
  padding-bottom: 100px;
}

/* 顶部标题栏 */
.header {
  background: #fff;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #eee;
}

.header-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
  flex: 1;
  text-align: center;
}

.header-icons {
  display: flex;
  gap: 16px;
  position: absolute;
  right: 16px;
}

.header-icons .iconfont {
  font-size: 20px;
  color: #666;
}

/* 用户信息 */
.user-info {
  background: #fff;
  padding: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.user-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
}

.user-details {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.user-name {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.user-company {
  font-size: 12px;
  color: #666;
}

.user-company .link {
  color: #1890ff;
}

.apply-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.apply-btn .iconfont {
  font-size: 24px;
  color: #333;
}

.apply-text {
  font-size: 12px;
  color: #666;
}

/* 考勤状态 */
.attendance-status {
  background: #fff;
  padding: 16px;
  display: flex;
  gap: 12px;
  margin-top: 8px;
}

.status-card {
  flex: 1;
  background: #f5f5f5;
  border-radius: 8px;
  padding: 12px;
}

.status-card.active {
  background: #e6f7ff;
}

.status-label {
  font-size: 14px;
  color: #333;
  margin-bottom: 4px;
  display: block;
}

.status-time {
  font-size: 12px;
  color: #666;
  display: flex;
  align-items: center;
  gap: 4px;
}

.status-time .iconfont {
  color: #52c41a;
  font-size: 14px;
}

/* 打卡按钮 */
.clock-section {
  background: #fff;
  padding: 32px 16px;
  display: flex;
  justify-content: center;
  margin-top: 8px;
}

.clock-circle {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  border: 2px solid #333;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.clock-circle.working {
  border-color: #52c41a;
}

.clock-circle:active {
  transform: scale(0.95);
}

.clock-text {
  font-size: 20px;
  font-weight: 600;
  color: #333;
  margin-bottom: 4px;
}

.clock-date {
  font-size: 14px;
  color: #666;
  margin-bottom: 4px;
}

.clock-time {
  font-size: 16px;
  color: #999;
}

/* 工时填报任务 */
.task-section {
  background: #fff;
  margin-top: 8px;
  padding: 16px;
}

.task-header {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid #eee;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.task-item {
  border: 1px solid #eee;
  border-radius: 8px;
  padding: 16px;
}

.task-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.task-name {
  font-size: 15px;
  font-weight: 500;
  color: #333;
}

.task-progress {
  font-size: 13px;
  color: #666;
}

.task-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.task-info {
  font-size: 13px;
  color: #999;
}

.task-status {
  font-size: 13px;
  color: #1890ff;
}

.task-status.completed {
  color: #52c41a;
}

.task-fill-rate {
  font-size: 13px;
  color: #666;
}
