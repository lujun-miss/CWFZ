<!--pages/records/records.wxml-->
<view class="container">
  <!-- 顶部标题 -->
  <view class="page-header">
    <text class="page-title">统计</text>
  </view>

  <!-- 月度统计卡片 -->
  <view class="stats-card">
    <view class="stats-header">
      <text class="stats-title">本月统计</text>
      <text class="stats-period">2026年4月</text>
    </view>
    
    <view class="stats-grid">
      <view class="stats-item">
        <text class="stats-value">22</text>
        <text class="stats-label">打卡天数</text>
      </view>
      <view class="stats-item">
        <text class="stats-value">176</text>
        <text class="stats-label">总工时</text>
      </view>
      <view class="stats-item">
        <text class="stats-value">8</text>
        <text class="stats-label">日均工时</text>
      </view>
    </view>
  </view>

  <!-- 项目工时分布 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">项目工时分布</text>
    </view>
    
    <view class="project-list">
      <view class="project-item" wx:for="{{projectStats}}" wx:key="id">
        <view class="project-info">
          <text class="project-name">{{item.name}}</text>
          <text class="project-hours">{{item.hours}}小时</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item.percentage}}%"></view>
        </view>
        <text class="project-percent">{{item.percentage}}%</text>
      </view>
    </view>
  </view>

  <!-- 打卡记录 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">打卡记录</text>
      <text class="view-more" bindtap="viewAllRecords">查看更多</text>
    </view>
    
    <view class="record-list">
      <view class="record-item" wx:for="{{checkRecords}}" wx:key="date">
        <view class="record-date">
          <text class="date-day">{{item.day}}</text>
          <text class="date-week">{{item.weekDay}}</text>
        </view>
        <view class="record-info">
          <view class="record-time">
            <text class="time-label">上班</text>
            <text class="time-value {{item.checkIn ? '' : 'missed'}}">{{item.checkIn || '未打卡'}}</text>
          </view>
          <view class="record-time">
            <text class="time-label">下班</text>
            <text class="time-value {{item.checkOut ? '' : 'missed'}}">{{item.checkOut || '未打卡'}}</text>
          </view>
        </view>
        <view class="record-status {{item.status}}">
          <text>{{item.statusText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 工时明细 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">工时明细</text>
    </view>
    
    <view class="workhour-list">
      <view class="workhour-item" wx:for="{{workHourDetails}}" wx:key="id">
        <view class="workhour-main">
          <text class="workhour-project">{{item.projectName}}</text>
          <text class="workhour-time">{{item.hours}}小时</text>
        </view>
        <view class="workhour-sub">
          <text class="workhour-date">{{item.date}}</text>
          <text class="workhour-content">{{item.content}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
