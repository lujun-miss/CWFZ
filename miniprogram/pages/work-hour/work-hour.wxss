/**pages/work-hour/work-hour.wxss**/
.container {
  padding: 16px;
  padding-bottom: 100px;
}

/* 页面标题 */
.page-header {
  margin-bottom: 16px;
}

.page-title {
  font-size: 20px;
  font-weight: 600;
  color: #333;
}

/* 项目卡片 */
.project-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.project-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.project-label {
  font-size: 13px;
  color: #999;
}

.project-change {
  font-size: 13px;
  color: #1890ff;
}

.project-info {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.project-name {
  font-size: 17px;
  font-weight: 600;
  color: #333;
}

.project-progress {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.progress-text {
  font-size: 13px;
  color: #666;
}

.progress-bar {
  height: 6px;
  background: #f0f0f0;
  border-radius: 3px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1890ff, #36cfc9);
  border-radius: 3px;
  transition: width 0.3s ease;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-column {
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
}

.form-label {
  width: 80px;
  font-size: 15px;
  color: #333;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 15px;
  color: #333;
}

.form-value .iconfont {
  font-size: 14px;
  color: #ccc;
}

/* 工时选择器 */
.workhour-selector {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.hour-buttons {
  display: flex;
  gap: 8px;
}

.hour-btn {
  flex: 1;
  height: 36px;
  line-height: 36px;
  text-align: center;
  background: #f5f5f5;
  border-radius: 6px;
  font-size: 14px;
  color: #666;
  transition: all 0.3s;
}

.hour-btn.active {
  background: #1890ff;
  color: #fff;
}

.hour-slider {
  width: 100%;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  height: 120px;
  padding: 12px;
  background: #f5f5f5;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1.6;
  box-sizing: border-box;
}

.textarea-count {
  align-self: flex-end;
  font-size: 12px;
  color: #999;
}

/* 设备列表 */
.device-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  width: 100%;
}

.device-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  background: #f5f5f5;
  border-radius: 20px;
  border: 2px solid transparent;
  transition: all 0.3s;
}

.device-item.selected {
  background: #e6f7ff;
  border-color: #1890ff;
}

.device-icon {
  font-size: 16px;
}

.device-name {
  font-size: 14px;
  color: #333;
}

.device-check {
  font-size: 12px;
  color: #1890ff;
  font-weight: 600;
}

/* 提交按钮 */
.submit-section {
  margin-top: 32px;
  padding: 0 16px;
}

.submit-btn {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #fff;
  font-size: 16px;
  font-weight: 500;
  border-radius: 24px;
  border: none;
  box-shadow: 0 4px 12px rgba(24, 144, 255, 0.3);
}

.submit-btn:active {
  transform: scale(0.98);
}

.submit-btn.disabled {
  background: #ccc;
  box-shadow: none;
}
