<!--pages/work-hour/work-hour.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">工时填报</text>
  </view>

  <!-- 项目信息 -->
  <view class="project-card">
    <view class="project-header">
      <text class="project-label">当前项目</text>
      <text class="project-change" bindtap="changeProject">切换项目</text>
    </view>
    <view class="project-info">
      <text class="project-name">{{projectName}}</text>
      <view class="project-progress">
        <text class="progress-text">当前进度：{{projectProgress}}%</text>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{projectProgress}}%"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 工时填报表单 -->
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">填报日期</text>
      <picker mode="date" value="{{workDate}}" bindchange="bindDateChange">
        <view class="form-value">
          <text>{{workDate}}</text>
          <text class="iconfont icon-arrow-right"></text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">工时</text>
      <view class="workhour-selector">
        <view class="hour-buttons">
          <view class="hour-btn {{workHours === 1 ? 'active' : ''}}" bindtap="selectHours" data-hours="1">1h</view>
          <view class="hour-btn {{workHours === 2 ? 'active' : ''}}" bindtap="selectHours" data-hours="2">2h</view>
          <view class="hour-btn {{workHours === 4 ? 'active' : ''}}" bindtap="selectHours" data-hours="4">4h</view>
          <view class="hour-btn {{workHours === 8 ? 'active' : ''}}" bindtap="selectHours" data-hours="8">8h</view>
        </view>
        <slider class="hour-slider" min="0.5" max="8" step="0.5" value="{{workHours}}" bindchange="sliderChange" show-value/>
      </view>
    </view>

    <view class="form-item form-item-column">
      <text class="form-label">工作内容</text>
      <textarea class="form-textarea" placeholder="请输入工作内容..." value="{{workContent}}" bindinput="inputContent" maxlength="500"></textarea>
      <text class="textarea-count">{{workContent.length}}/500</text>
    </view>

    <view class="form-item form-item-column">
      <text class="form-label">使用设备</text>
      <view class="device-list">
        <view class="device-item {{item.selected ? 'selected' : ''}}" wx:for="{{deviceList}}" wx:key="id" bindtap="toggleDevice" data-id="{{item.id}}">
          <text class="device-icon">{{item.icon}}</text>
          <text class="device-name">{{item.name}}</text>
          <text class="device-check" wx:if="{{item.selected}}">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn {{canSubmit ? '' : 'disabled'}}" bindtap="submitWorkHour">提交工时</button>
  </view>
</view>
